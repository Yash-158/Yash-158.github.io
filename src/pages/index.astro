---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Metric from "../components/Metric.astro";
import Burst from "../components/Burst.astro";
import Squiggle from "../components/Squiggle.astro";
import Planet from "../components/Planet.astro";
import DocCard from "../components/DocCard.astro";
import {
  site, hero, about, stats, services, papers, thirdPaper, ip, projects, moreProjects,
  sih, wins, press, organisations, experience, education,
  skills, beyondCode, events,
} from "../data/site.js";
import { documents, documentTypes, doc, docsFor } from "../data/documents.js";

const featured = projects.filter((p) => p.featured);
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const more = moreProjects.map((m) => ({
  ...m,
  href: m.page ? `/projects/${m.page}` : m.href,
  document: m.doc ? doc(m.doc) : null,
}));

// Wins: every card gets its photo, certificate and press items from documents.js.
const winData = (w) => {
  const linked = docsFor.win(w.id);
  return {
    ...w,
    certificate: linked.find((d) => !d.photo && d.type !== "press"),
    photos: linked.filter((d) => d.photo),
    pressDocs: linked.filter((d) => d.type === "press"),
    projectPage: w.project ? { href: `/projects/${w.project}`, name: bySlug[w.project].name } : null,
  };
};
const sihWin = winData(sih);
const allWins = [sihWin, ...wins.map(winData)];
const pressItems = press.map((p) => ({ ...p, document: p.doc ? doc(p.doc) : null }));

// Experience: the certificate button comes from documents.js
const jobs = experience.map((j) => ({
  ...j,
  certificate: docsFor.experience(j.id),
  extra: j.extraDoc ? doc(j.extraDoc) : null,
  pressDoc: j.press ? doc(j.press) : null,
}));

// Certificates on the home page: every document except the photos, which live in the wins.
const homeDocs = documents.filter((d) => d.type !== "photo");
const filters = [
  { id: "all", label: "All", count: homeDocs.length },
  ...documentTypes.map((t) => ({ ...t, count: homeDocs.filter((d) => d.type === t.id).length })).filter((t) => t.count > 0),
];
---
<Base current="Home" personSchema>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        {hero.lines[0]}<br /><span class="accent">{hero.lines[1]}</span><br />{hero.lines[2]}<Icon name="sparkle" class="sparkle" color="var(--accent)" size={44} />
      </h1>
      <p class="hero__intro">{hero.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--blue" href="#contact">Let's talk<Icon name="arrow" size={15} stroke={2.2} /></a>
        <a class="btn btn--line" href={site.resume} target="_blank" rel="noopener">Download resume</a>
      </div>
    </div>
    <div class="hero__art">
      <img class="hero__grain" src="/images/grain.webp" alt="" aria-hidden="true" width="720" height="720" fetchpriority="low" />
      <Planet />
      <Icon name="sparkle" size={22} class="float-sparkle float-sparkle--a" />
      <Icon name="sparkle" size={16} class="float-sparkle float-sparkle--b" />
      <img class="hero__photo" src="/images/yash-shah.webp" alt={hero.photoAlt} width="640" height="941" fetchpriority="high" />
      <span class="hero__ground" aria-hidden="true"></span>
      <p class="sticker sticker--isro"><Icon name="sparkle" size={14} color="#9DB4FF" />{hero.stickers.isro}</p>
      <p class="sticker sticker--oval" aria-hidden="true"><span>{hero.oval[0]}</span><span>{hero.oval[1]}</span></p>
      <p class="sticker sticker--sih badge-card badge-card--white">
        <Icon name="trophy" size={30} stroke={1.7} color="var(--accent)" />
        <span><strong>{hero.stickers.sih.title}</strong><span>{hero.stickers.sih.text}</span></span>
      </p>
      <p class="sticker sticker--papers badge-card badge-card--blue">
        <Icon name="book" size={30} stroke={1.7} color="#fff" />
        <span><strong>{hero.stickers.papers.title}</strong><span>{hero.stickers.papers.text}</span></span>
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about" aria-labelledby="about-title">
    <div class="about__copy">
      <p class="about__hi">HI, I'M</p>
      <h2 class="about__name" id="about-title">{site.name}</h2>
      <p class="about__text">{about.paragraph.map(([t, u]) => (u ? <span class="u">{t}</span> : t))}</p>
      <p class="about__find">Find me on</p>
      <div class="pill-row">
        <a class="pill" href={site.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a class="pill" href={site.github} target="_blank" rel="me noopener">GitHub</a>
        <a class="pill pill--dark" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
    <div class="burst-wrap">
      <img src="/images/grain.webp" alt="" aria-hidden="true" width="720" height="720" loading="lazy" />
      <Burst href="#contact" lines={about.badge} fill="var(--accent)" label="Open to internships from January to July 2027. Get in touch." />
    </div>
  </section>

  <!-- Stats -->
  <div class="stats-band band">
    <ul class="stats grid-lines" aria-label="At a glance">
      {stats.map((s) => (
        <li>
          <span class="visually-hidden">{s.value}</span>
          <span class="stats__value" aria-hidden="true" data-count={s.value}>{s.value}</span>
          <span class="stats__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- What I do -->
  <section class="services" aria-labelledby="services-title">
    <div class="services__head">
      <h2 class="h-section" id="services-title">From research papers to real products.</h2>
      <a class="btn btn--blue btn--sm" href="#work">See my work<Icon name="arrow" size={14} stroke={2.2} /></a>
    </div>
    <div class="card-grid">
      {services.map((s) => (
        <article class={`svc tone-${s.tone}`}>
          <Icon name={s.icon} size={46} stroke={1.8} class="ico" />
          <h3>{s.title}</h3>
          <p class="svc__sub">{s.sub}</p>
          <ul>
            {s.items.map((i) => <li><Icon name="check" size={16} stroke={2.4} />{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Research -->
  <section class="research" id="research" aria-labelledby="research-title">
    <div class="section-head">
      <h2 class="h-section" id="research-title">Published research</h2>
      <Squiggle />
    </div>
    {papers.map((p, i) => (
      <article class={`row${i % 2 ? " row--flip" : ""}`}>
        <div class="row__copy">
          {p.journalLine ? (
            <p class="row__venue"><em>{p.journal}</em>{p.journalLine}</p>
          ) : (
            <p class="row__venue">{p.venue} <em>{p.journal}</em></p>
          )}
          <h3 class="row__title">{p.title}</h3>
          {p.journalLine ? (
            <p class="row__authors">
              {p.authors.map(([n, me, extra], k) => (
                <>{k > 0 && ", "}{me ? <strong>{n}</strong> : n}{extra}</>
              ))}.
            </p>
          ) : (
            <p class="row__authors">
              {p.authors.map(([n, me, extra], k) => (
                <>{k > 0 && ", "}{me ? <strong>{n}</strong> : n}{extra}</>
              ))}. {p.status}
            </p>
          )}
          <p class="row__text">{p.text}</p>
          <div class="row__links">
            <a class="circle-link" href={p.link} target="_blank" rel="noopener">
              <span class="circle-link__dot"><Icon name="arrow" size={18} /></span>Journal page
            </a>
            {p.doc && (
              <a class="ul-link" href={doc(p.doc).url}>Presented at ICISHCT-2026<span class="visually-hidden">, view the certificate</span></a>
            )}
          </div>
        </div>
        <div class="row__art" aria-hidden="true"><Metric metric={p.card} /></div>
      </article>
    ))}
    <p class="third-paper"><Icon name="sparkle" size={14} color="var(--accent)" />{thirdPaper}</p>
  </section>

  <!-- Intellectual property -->
  <section class="ip band" id="intellectual-property" aria-labelledby="ip-title">
    <div class="section-head">
      <h2 class="h-section" id="ip-title">{ip.title}</h2>
      <Squiggle />
    </div>
    <p class="lead ip__intro">{ip.intro}</p>
    <ul class="ip-list">
      {ip.designs.map((x) => (
        <li class={`ip-row${x.accepted ? " ip-row--accepted" : ""}`}>
          <h3 class="ip-row__name">{x.name}</h3>
          <p class="ip-row__status">
            <span class={`ip-badge${x.accepted ? " ip-badge--accepted" : ""}`}>{x.status}</span>
            {x.note && <span class="ip-row__note">{x.note}</span>}
          </p>
          {x.doc ? (
            <a class="text-link ip-row__link" href={doc(x.doc).url}>{x.linkText}<Icon name="right" size={15} stroke={2.2} /><span class="visually-hidden">: {x.name}</span></a>
          ) : <span class="ip-row__link" aria-hidden="true"></span>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Work -->
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 class="h-section" id="work-title">Explore my top creations</h2>
      <Squiggle />
    </div>
    {featured.map((p, i) => (
      <article class={`row${i % 2 ? " row--flip" : ""}`}>
        <div class="row__copy">
          <p class="row__venue">{p.category}, {p.period}</p>
          <h3 class="row__name"><a href={`/projects/${p.slug}`}>{p.name}.</a></h3>
          <p class="row__summary">{p.summary}</p>
          {p.badge && <p class="row__tags"><span class="tag">{p.badge}</span></p>}
          <p class="row__stack">{p.stackShort}</p>
          {p.homeNote && <p class="row__note">{p.homeNote}</p>}
          <div class="row__links">
            <a class="circle-link circle-link--blue" href={`/projects/${p.slug}`}>
              <span class="circle-link__dot"><Icon name="arrow" size={18} /></span>View project<span class="visually-hidden">: {p.name}</span>
            </a>
            {(p.homeLinks || []).map((l) => (
              <a class="ul-link" href={l.href} target={/^https?:/.test(l.href) ? "_blank" : undefined} rel={/^https?:/.test(l.href) ? "noopener" : undefined}>{l.label}</a>
            ))}
          </div>
        </div>
        <div class="row__art" aria-hidden="true"><Metric metric={p.metric} /></div>
      </article>
    ))}

    <!-- More things I've made -->
    <div class="more" aria-labelledby="more-title">
      <div class="more__head">
        <h3 class="more__title" id="more-title">More things I've made</h3>
        <p class="more__intro">Smaller projects and hackathon builds.</p>
      </div>
      <ul class="more-grid">
        {more.map((m) => (
          <li class="pcard">
            {m.thumb ? (
              <a class={`pcard__thumb pcard__thumb--${m.fit || "screen"}`} href={m.href} tabindex="-1" aria-hidden="true">
                <img src={m.thumb} alt="" aria-hidden="true" loading="lazy" decoding="async" style={m.focus ? `object-position: ${m.focus}` : undefined} />
              </a>
            ) : (
              <span class="pcard__thumb pcard__thumb--art" aria-hidden="true">
                <img src="/images/grain.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                <Icon name={m.icon || "sparkle"} size={46} stroke={1.8} />
              </span>
            )}
            <div class="pcard__body">
              <span class="pcard__tag">{m.tag}</span>
              <h4 class="pcard__name">{m.page ? <a href={m.href}>{m.name}</a> : m.name}</h4>
              <p class="pcard__line">{m.line}</p>
              <div class="pcard__links">
                {m.page && <a class="text-link" href={m.href}>View project<Icon name="right" size={15} stroke={2.2} /><span class="visually-hidden">: {m.name}</span></a>}
                {!m.page && m.href && <a class="text-link" href={m.href} target="_blank" rel="noopener">{m.hrefLabel}<Icon name="arrow" size={14} stroke={2.2} /><span class="visually-hidden">: {m.name}</span></a>}
                {m.document && <a class="text-link" href={m.document.url}>{m.document.linkLabel || "Certificate"}<Icon name="right" size={15} stroke={2.2} /><span class="visually-hidden">: {m.document.shortTitle}</span></a>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Wins -->
  <section class="wins" id="achievements" aria-labelledby="wins-title">
    <div class="section-head">
      <h2 class="h-section" id="wins-title">Wins and recognition</h2>
      <Squiggle color="#FFFFFF" />
    </div>
    <p class="wins__hint">Open any card for the details, photos and certificate.</p>

    <a class="sih-card" href={`#win-${sihWin.id}`} data-win={sihWin.id} aria-haspopup="dialog">
      <div class="sih-card__main">
        <span class="tag">{sih.pill}</span>
        <h3 class="sih-card__title">{sih.title}</h3>
        <p class="sih-card__text">{sih.text}</p>
        <span class="sih-card__more">See the details<Icon name="right" size={16} stroke={2.2} /></span>
      </div>
      {sihWin.photos[0] && (
        <span class="sih-card__photo"><img src={sihWin.photos[0].thumb} alt="" aria-hidden="true" loading="lazy" decoding="async" /></span>
      )}
      <ul class="sih-card__stats">
        {sih.stats.map(([v, t]) => <li><strong>{v}</strong><span>{t}</span></li>)}
      </ul>
    </a>

    <ul class="win-grid">
      {allWins.slice(1).map((w) => (
        <li>
          <a class="win-card" href={`#win-${w.id}`} data-win={w.id} aria-haspopup="dialog">
            <span class="win-card__top">
              <span class="win-card__icon"><Icon name={w.icon} size={24} stroke={1.8} /></span>
              <span class="win-card__date">{w.date}</span>
            </span>
            <span class="win-card__title">{w.title}</span>
            <span class="win-card__summary">{w.summary}</span>
            <span class="win-card__more">
              {w.certificate ? "Details and certificate" : "Details"}<Icon name="right" size={15} stroke={2.2} />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="press-wrap">
      <h3 class="label">In the press</h3>
      <ul class="press-grid">
        {pressItems.map((p) => (
          <li>
            {p.document ? (
              <a class="press-card" href={p.document.url}>
                <span class="press-card__thumb"><img src={p.document.thumb} alt="" aria-hidden="true" loading="lazy" decoding="async" /></span>
                <span class="press-card__body">
                  <span class="press-card__title"><Icon name="news" size={18} />{p.title}</span>
                  <span class="press-card__text">{p.text}</span>
                  <span class="press-card__more">Read the story<Icon name="right" size={15} stroke={2.2} /></span>
                </span>
              </a>
            ) : (
              <div class="press-card press-card--plain">
                <span class="press-card__body">
                  <span class="press-card__title"><Icon name="news" size={18} />{p.title}</span>
                  <span class="press-card__text">{p.text}</span>
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="marquee">
      <p class="label">Where my work has been</p>
      <div class="marquee__viewport">
        <div class="marquee__track">
          {[0, 1].map((copy) => (
            <p class="marquee__group" aria-hidden={copy === 1 ? "true" : undefined}>
              {organisations.map((o) => (
                <><span>{o}</span><Icon name="sparkle" size={16} color="#FFFFFF" /></>
              ))}
            </p>
          ))}
        </div>
      </div>
    </div>

    <!-- Detail panels. With JavaScript they open as modal dialogs. Without it,
         the card links jump to them and CSS shows the panel (:target). -->
    {allWins.map((w) => (
      <dialog class="win-panel" id={`win-${w.id}`} aria-labelledby={`win-${w.id}-title`}>
        <div class="win-panel__inner">
          <div class="win-panel__head">
            <span class="win-panel__date">{w.date || w.pill}</span>
            <a class="win-panel__close" href="#achievements" data-close aria-label="Close"><Icon name="close" size={22} /></a>
          </div>
          <h3 class="win-panel__title" id={`win-${w.id}-title`}>{w.title}</h3>
          <ul class="win-panel__detail">
            {w.detail.map((line) => <li>{line}</li>)}
          </ul>
          {(w.photos.length > 0 || w.certificate) && (
            <div class="win-panel__media">
              {w.photos.map((ph) => (
                <figure>
                  <a href={ph.image} data-lightbox={`win-${w.id}`} data-caption={ph.description}>
                    <img src={ph.thumb} alt={ph.alt} loading="lazy" decoding="async" />
                  </a>
                  <figcaption>Photo, {ph.when}</figcaption>
                </figure>
              ))}
              {w.certificate && (
                <figure>
                  <a href={w.certificate.url}>
                    <img src={w.certificate.thumb} alt={w.certificate.alt} loading="lazy" decoding="async" />
                  </a>
                  <figcaption>Certificate, {w.certificate.when}</figcaption>
                </figure>
              )}
            </div>
          )}
          <div class="win-panel__links">
            {w.certificate && <a class="btn btn--blue btn--sm" href={w.certificate.url}>View certificate<Icon name="right" size={15} stroke={2.2} /></a>}
            {w.projectPage && <a class="btn btn--line btn--sm" href={w.projectPage.href}>See {w.projectPage.name}</a>}
            {w.pressDocs.map((pd) => <a class="ul-link" href={pd.url}>{pd.issuer} story</a>)}
          </div>
        </div>
      </dialog>
    ))}
  </section>

  <!-- Experience -->
  <section class="experience" id="experience" aria-labelledby="exp-title">
    <div class="section-head">
      <h2 class="h-section" id="exp-title">Where I've worked</h2>
      <Squiggle />
    </div>
    <ol class="jobs-grid">
      {jobs.map((j) => (
        <li class={`job${j.featured ? " job--featured" : ""}`}>
          <div class="job__main">
            <p class="job__dates"><Icon name="sparkle" size={14} />{j.dates}</p>
            <h3 class="job__role">{j.role}</h3>
            <p class="job__org"><strong>{j.org}</strong><span class="job__place"><Icon name="pin" size={16} />{j.place}</span></p>
            <ul class="job__points">
              {j.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <ul class="chips" aria-label="Tools and data">
              {j.tech.map((t) => <li>{t}</li>)}
            </ul>
            {(j.certificate || j.pressDoc) && (
              <div class="job__links">
                {j.certificate && <a class={`btn btn--sm ${j.featured ? "btn--white" : "btn--blue"}`} href={j.certificate.url}>View certificate<Icon name="right" size={15} stroke={2.2} /><span class="visually-hidden">: {j.org}</span></a>}
                {j.extra && <a class="ul-link" href={j.extra.url}>Appreciation letter</a>}
                {j.pressDoc && <a class="ul-link" href={j.pressDoc.url}>Featured in {j.pressDoc.issuer.split(",")[0]}</a>}
              </div>
            )}
          </div>
          {j.featured && j.certificate && (
            <a class="job__doc" href={j.certificate.url} tabindex="-1" aria-hidden="true">
              <img src={j.certificate.thumb} alt="" aria-hidden="true" loading="lazy" decoding="async" />
            </a>
          )}
        </li>
      ))}
      <li class="job job--edu">
        <div class="job__main">
          <p class="job__dates"><Icon name="sparkle" size={14} />{education.dates}</p>
          <h3 class="job__role">{education.role}</h3>
          <p class="job__org"><strong>{education.org}</strong></p>
          <p class="job__text">{education.text}</p>
        </div>
      </li>
    </ol>
  </section>

  <!-- Certificates -->
  <section class="certificates band" id="certificates" aria-labelledby="certs-title">
    <div class="certs__head">
      <div>
        <h2 class="h-section" id="certs-title">Certificates</h2>
        <p class="certs__intro">Every internship, hackathon, course and letter, each with its own page, the original document and a verify link wherever the issuer has one.</p>
      </div>
      <a class="btn btn--line btn--sm" href="/certificates">All certificates<Icon name="right" size={15} stroke={2.2} /></a>
    </div>
    <div class="filters" role="group" aria-label="Filter certificates" data-filter-group="home">
      {filters.map((f) => (
        <button type="button" class="filter" data-filter={f.id} aria-pressed={f.id === "all" ? "true" : "false"}>
          {f.label} <span>{f.count}</span>
        </button>
      ))}
    </div>
    <p class="visually-hidden" aria-live="polite" data-filter-status="home"></p>
    <ul class="doc-grid" data-filter-list="home" data-collapse="6">
      {homeDocs.map((d) => <DocCard doc={d} />)}
    </ul>
    <p class="certs__more">
      <button type="button" class="btn btn--blue btn--sm" data-show-all="home" hidden>Show all {homeDocs.length} certificates</button>
      <a class="ul-link" href="/certificates">Open the full certificates page</a>
    </p>
  </section>

  <!-- Skills, beyond code, events -->
  <section class="details-wrap" aria-label="Skills and activities">
    <div class="details grid-lines">
    <div>
      <h2>Skills</h2>
      <dl>
        {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
    <div>
      <h2>Beyond code</h2>
      <ul>{beyondCode.map(([a, b]) => <li><strong>{a}</strong><span>{b}</span></li>)}</ul>
    </div>
    <div>
      <h2>Events I've attended</h2>
      <ul>{events.map(([a, b]) => <li><strong>{a}</strong><span>{b}</span></li>)}</ul>
    </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact" aria-labelledby="contact-title">
    <svg class="contact__loop contact__loop--l" viewBox="0 0 260 200" aria-hidden="true"><path d="M10 180C40 120 30 40 70 30 110 20 100 120 70 140 40 160 60 60 110 50 160 40 150 140 120 150 90 160 120 60 170 60 220 60 200 150 250 120" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" /></svg>
    <svg class="contact__loop contact__loop--r" viewBox="0 0 260 200" aria-hidden="true"><path d="M10 180C40 120 30 40 70 30 110 20 100 120 70 140 40 160 60 60 110 50 160 40 150 140 120 150 90 160 120 60 170 60 220 60 200 150 250 120" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" /></svg>
    <h2 id="contact-title">Anything in mind?<br />Let's talk.</h2>
    <Burst href={`mailto:${site.email}`} lines={["I'm ready", "to talk"]} fill="#0B0B14" label={`Email me at ${site.email}`} />
    <p class="contact__email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <div class="contact__actions">
      <button type="button" class="copy-btn" data-copy={site.email}><Icon name="copy" size={15} /><span data-copy-label>Copy email</span></button>
      <a class="pill" href={site.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
      <a class="pill" href={site.github} target="_blank" rel="me noopener">GitHub</a>
    </div>
  </section>
</Base>

<script>
  import "../scripts/filters.ts";

  // Win panels open as modal dialogs: focus stays inside, Esc closes them,
  // and focus goes back to the card that opened them.
  document.querySelectorAll<HTMLAnchorElement>("[data-win]").forEach((card) => {
    const panel = document.getElementById(`win-${card.dataset.win}`) as HTMLDialogElement | null;
    if (!panel || typeof panel.showModal !== "function") return;
    card.addEventListener("click", (e) => {
      e.preventDefault();
      panel.showModal();
      panel.querySelector<HTMLElement>("[data-close]")?.focus();
    });
    panel.addEventListener("close", () => card.focus());
  });
  document.querySelectorAll<HTMLDialogElement>(".win-panel").forEach((panel) => {
    panel.querySelector("[data-close]")?.addEventListener("click", (e) => {
      if (!panel.open) return; // without a modal, the link simply goes back to the section
      e.preventDefault();
      panel.close();
    });
    // A click on the dark area around the panel closes it
    panel.addEventListener("click", (e) => { if (e.target === panel) panel.close(); });
    // Tab and Shift+Tab loop inside the panel while it is open
    panel.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;
      const items = Array.from(panel.querySelectorAll<HTMLElement>("a[href], button")).filter((el) => el.offsetParent !== null);
      const first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  });

  // Copy email
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector("[data-copy-label]");
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        document.body.appendChild(area);
        area.select();
        document.execCommand("copy");
        area.remove();
      }
      if (label) {
        label.textContent = "Copied";
        setTimeout(() => { label.textContent = "Copy email"; }, 2000);
      }
    });
  });
</script>
