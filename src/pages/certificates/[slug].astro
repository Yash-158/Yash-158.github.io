---
// One page per document, at /certificates/<slug>. This is the address used in the resume.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { documents, documentTypes } from "../../data/documents.js";
import { projects } from "../../data/site.js";

export function getStaticPaths() {
  return documents.map((d) => {
    const same = documents.filter((x) => x.type === d.type);
    const i = same.indexOf(d);
    return {
      params: { slug: d.slug },
      props: { d, prev: same[i - 1] || null, next: same[i + 1] || null, position: i + 1, total: same.length },
    };
  });
}

const { d, prev, next, position, total } = Astro.props;
const type = documentTypes.find((t) => t.id === d.type);
const project = d.related?.project ? projects.find((p) => p.slug === d.related.project) : null;
const relatedHref = project ? `/projects/${project.slug}` : d.related?.section;
const kind = d.photo ? "photo" : d.type === "press" ? "story" : "certificate";
const fileLabel = d.photo ? "Open the original photo" : "Open the original (PDF)";
---
<Base
  title={`${d.shortTitle} | Yash Shah`}
  description={d.description}
  current="Certificates"
  image={d.share}
  imageAlt={d.alt}
>
  <article class="doc-page">
    <nav class="doc-page__crumbs" aria-label="Breadcrumb">
      <a class="back-link" href="/"><Icon name="left" size={16} />Back to portfolio</a>
      <span aria-hidden="true">/</span>
      <a href="/certificates">All certificates</a>
      <span aria-hidden="true">/</span>
      <a href={`/certificates#group-${d.type}`}>{type.label}</a>
    </nav>

    <div class="doc-hero">
      <div class="doc-hero__copy">
        <p class="eyebrow">{type.one}, {position} of {total}</p>
        <h1 class="doc-hero__title">{d.shortTitle}</h1>
        <p class="doc-hero__desc">{d.description}</p>
        <dl class="doc-facts">
          <div><dt>{d.photo ? "Photo" : "Title"}</dt><dd>{d.title}</dd></div>
          <div><dt>{d.type === "press" ? "Published by" : d.photo ? "Event" : "Issued by"}</dt><dd>{d.printedIssuer || d.issuer}</dd></div>
          {d.dates && <div><dt>Date</dt><dd>{d.dates}</dd></div>}
        </dl>
        <div class="doc-actions">
          {d.verify && (
            <a class="btn btn--blue" href={d.verify} target="_blank" rel="noopener"><Icon name="shield" size={18} />Verify on the issuer's site</a>
          )}
          <a class={`btn ${d.verify ? "btn--line" : "btn--blue"}`} href={d.file} target="_blank" rel="noopener"><Icon name="file" size={18} />{fileLabel}</a>
        </div>
        {relatedHref && (
          <a class="doc-related" href={relatedHref}>
            <span class="doc-related__label">Related</span>
            <span class="doc-related__name">{d.related.label}</span>
            <Icon name="right" size={20} stroke={2.2} />
          </a>
        )}
        {(d.redacted || d.imageNote) && (
          <p class="doc-note">{d.redacted && <>{d.redacted} Nothing else on the {kind} is changed. </>}{d.imageNote}</p>
        )}
      </div>

      <figure class="doc-figure">
        <img class="cloud" src="/images/grain.webp" alt="" aria-hidden="true" width="720" height="720" />
        <a class="doc-figure__frame" href={d.image} data-lightbox="doc" data-caption={d.shortTitle} data-full={d.file}>
          <img src={d.image} alt={d.alt} decoding="async" />
          <span class="doc-figure__zoom"><Icon name="expand" size={18} />Click to zoom</span>
        </a>
        <figcaption>{d.photo ? "Click the photo to see it full size." : `Click the ${kind} to see it full size.`}</figcaption>
      </figure>
    </div>

    <nav class="doc-nav" aria-label={`More ${type.label.toLowerCase()}`}>
      {prev ? (
        <a class="doc-nav__link" href={prev.url} rel="prev">
          <span class="doc-nav__dir"><Icon name="left" size={16} />Previous</span>
          <span class="doc-nav__name">{prev.shortTitle}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a class="doc-nav__link doc-nav__link--next" href={next.url} rel="next">
          <span class="doc-nav__dir">Next<Icon name="right" size={16} /></span>
          <span class="doc-nav__name">{next.shortTitle}</span>
        </a>
      ) : <span></span>}
    </nav>
    <p class="doc-back">
      <a class="btn btn--line btn--sm" href="/certificates">All certificates</a>
      <a class="btn btn--line btn--sm" href="/">Back to portfolio</a>
    </p>
  </article>
</Base>
