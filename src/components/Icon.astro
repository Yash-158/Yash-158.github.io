---
// Small inline SVG icon set, drawn as simple line icons to match the design.
interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
  color?: string;
}
const { name, size = 24, stroke = 2, class: className, color } = Astro.props;

const SPARKLE = "M12 0C12.8 6.5 17.5 11.2 24 12 17.5 12.8 12.8 17.5 12 24 11.2 17.5 6.5 12.8 0 12 6.5 11.2 11.2 6.5 12 0Z";

// 24x24 line icons
const line: Record<string, string> = {
  arrow: '<path d="M7 17L17 7M9 7h8v8"/>',
  right: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  left: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  check: '<path d="M5 12l4 4 10-10"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>',
  trophy: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/>',
  book: '<path d="M4 19.5V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M8 7h6M8 11h4"/>',
  flag: '<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>',
  bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>',
  medal: '<circle cx="12" cy="15" r="6"/><path d="M8.5 10.2L6 3h4l2 5 2-5h4l-2.5 7.2M12 12.5v5M10.5 13.5L12 12.5"/>',
  news: '<rect x="3" y="4" width="15" height="16" rx="1.5"/><path d="M18 8h3v10a2 2 0 0 1-2 2H6M7 8h7M7 12h7M7 16h4"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  file: '<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  expand: '<path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/>',
};

// 48x48 feature icons
const big: Record<string, string> = {
  wave: '<path d="M4 26h6l4-12 6 22 6-18 4 10 4-4h10"/><circle cx="38" cy="10" r="4"/>',
  code: '<rect x="5" y="8" width="38" height="28" rx="3"/><path d="M16 42h16M24 36v6M17 18l-5 4 5 4M31 18l5 4-5 4M26 15l-4 14"/>',
  chip: '<rect x="13" y="13" width="22" height="22" rx="3"/><rect x="19" y="19" width="10" height="10" rx="1.5"/><path d="M19 5v8M29 5v8M19 35v8M29 35v8M5 19h8M5 29h8M35 19h8M35 29h8"/>',
  cube: '<path d="M8 16l16-9 16 9v16l-16 9-16-9z"/><path d="M8 16l16 9 16-9M24 25v16"/>',
  camera: '<path d="M6 16h8l3-5h14l3 5h8v22H6z"/><circle cx="24" cy="26" r="7"/>',
  chart: '<rect x="5" y="8" width="38" height="28" rx="3"/><path d="M16 42h16M24 36v6M12 29l7-8 6 5 9-11"/>',
  mic: '<rect x="18" y="5" width="12" height="22" rx="6"/><path d="M10 22a14 14 0 0 0 28 0M24 36v7M17 43h14"/>',
  columns: '<rect x="5" y="8" width="16" height="32" rx="3"/><rect x="27" y="8" width="16" height="32" rx="3"/><path d="M9 15h8M9 21h8M9 27h5M31 15h8M31 21h8M31 27h5"/>',
  tap: '<path d="M18 22V10a3 3 0 0 1 6 0v12"/><path d="M24 20a3 3 0 0 1 6 0v3M30 22a3 3 0 0 1 6 0v8c0 7-5 12-11 12h-2c-4 0-7-2-9-5l-5-8a3 3 0 0 1 5-3l3 3"/>',
  help: '<circle cx="24" cy="24" r="18"/><path d="M19 19a5 5 0 1 1 7 4.6c-1.3.6-2 1.8-2 3.2V29M24 35h.01"/>',
  phone: '<rect x="13" y="4" width="22" height="40" rx="4"/><path d="M21 38h6"/>',
  map: '<path d="M6 12l11-5 14 5 11-5v29l-11 5-14-5-11 5z"/><path d="M17 7v29M31 12v29"/>',
  eye: '<path d="M3 24s8-14 21-14 21 14 21 14-8 14-21 14S3 24 3 24z"/><circle cx="24" cy="24" r="6"/>',
  cart: '<path d="M5 7h6l5 24h22l4-16H13"/><circle cx="19" cy="39" r="3"/><circle cx="35" cy="39" r="3"/>',
  bolt: '<path d="M27 4L9 27h14l-2 17 18-23H25z"/>',
  home: '<path d="M6 22L24 7l18 15M11 18v22h26V18"/><path d="M20 40V28h8v12"/>',
  music: '<path d="M18 36V10l22-5v26"/><circle cx="13" cy="36" r="5"/><circle cx="35" cy="31" r="5"/>',
  clock: '<circle cx="24" cy="24" r="18"/><path d="M24 13v11l7 5"/>',
  screen: '<rect x="4" y="9" width="40" height="26" rx="3"/><path d="M17 41h14M24 35v6"/>',
  user: '<circle cx="24" cy="16" r="8"/><path d="M8 42c2-9 8-13 16-13s14 4 16 13"/>',
  hash: '<path d="M10 18h30M8 30h30M20 8l-4 32M32 8l-4 32"/>',
};

const isBig = name in big;
const isLine = name in line;
const viewBox = isBig ? "0 0 48 48" : "0 0 24 24";
const inner = isBig ? big[name] : isLine ? line[name] : "";
---
{name === "sparkle" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className}><path d={SPARKLE} fill={color || "currentColor"} /></svg>
) : (
  <svg
    width={size}
    height={size}
    viewBox={viewBox}
    fill="none"
    stroke={color || "currentColor"}
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
    set:html={inner}
  />
)}
