---
import Icon from "./Icon.astro";
import { site, nav } from "../data/site.js";

interface Props {
  current?: string; // label of the nav item to highlight
}
const { current = "Home" } = Astro.props;
const items = [{ label: "Home", href: "/" }, ...nav];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Yash Shah, home">{site.name}</a>
  <nav class="site-nav" aria-label="Main">
    {items.map((item) => (
      <a href={item.href} class={item.label === current ? "is-current" : undefined} aria-current={item.label === current ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <a class="resume-btn" href={site.resume} target="_blank" rel="noopener">
    Resume<Icon name="arrow" size={14} stroke={2.2} />
    <span class="visually-hidden">(PDF, opens in a new tab)</span>
  </a>
</header>
