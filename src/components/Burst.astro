---
// Scalloped starburst badge with text in the middle.
import Icon from "./Icon.astro";
interface Props {
  href: string;
  lines: string[];
  fill: string;
  label: string;
}
const { href, lines, fill, label } = Astro.props;
const POINTS =
  "50.0,0.0 55.5,4.8 62.0,1.5 66.1,7.5 73.2,5.7 75.8,12.6 83.2,12.6 84.1,19.8 91.1,21.6 90.3,28.9 96.8,32.3 94.2,39.1 99.6,44.0 95.5,50.0 99.6,56.0 94.2,60.9 96.8,67.7 90.3,71.1 91.1,78.4 84.1,80.2 83.2,87.4 75.8,87.4 73.2,94.3 66.1,92.5 62.0,98.5 55.5,95.2 50.0,100.0 44.5,95.2 38.0,98.5 33.9,92.5 26.8,94.3 24.2,87.4 16.8,87.4 15.9,80.2 8.9,78.4 9.7,71.1 3.2,67.7 5.8,60.9 0.4,56.0 4.5,50.0 0.4,44.0 5.8,39.1 3.2,32.3 9.7,28.9 8.9,21.6 15.9,19.8 16.8,12.6 24.2,12.6 26.8,5.7 33.9,7.5 38.0,1.5 44.5,4.8";
---
<a class="burst" href={href} aria-label={label}>
  <svg class="burst__shape" viewBox="0 0 100 100" aria-hidden="true"><polygon points={POINTS} fill={fill} /></svg>
  <span class="burst__text" aria-hidden="true">
    {lines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}
    <Icon name="arrow" size={16} stroke={2.2} />
  </span>
</a>
